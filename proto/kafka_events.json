{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KubeHealer Kafka Event Schemas",
  "topics": {
    "incident.alerts.raw": {
      "description": "Normalized alert payload produced by alert-gateway when Prometheus fires an incident",
      "properties": {
        "incident_id": { "type": "string" },
        "fingerprint": { "type": "string" },
        "status": { "type": "string", "enum": ["firing", "resolved"] },
        "alert_name": { "type": "string" },
        "severity": { "type": "string" },
        "namespace": { "type": "string" },
        "pod_name": { "type": "string" },
        "deployment_name": { "type": "string" },
        "starts_at": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      },
      "required": ["incident_id", "fingerprint", "alert_name", "namespace"]
    },
    "incident.diagnostics.stream": {
      "description": "Real-time AI thought tokens and tool logs produced by agent-worker for UI streaming",
      "properties": {
        "incident_id": { "type": "string" },
        "step_type": { "type": "string", "enum": ["triage", "tool_call", "thought", "remediation_proposal"] },
        "agent_name": { "type": "string" },
        "message": { "type": "string" },
        "tool_name": { "type": "string" },
        "tool_payload": { "type": "object" },
        "timestamp_unix": { "type": "integer" }
      },
      "required": ["incident_id", "step_type", "message"]
    },
    "incident.remediation.proposals": {
      "description": "YAML diff proposals generated by AI worker awaiting human approval",
      "properties": {
        "incident_id": { "type": "string" },
        "namespace": { "type": "string" },
        "target_name": { "type": "string" },
        "diagnosis_summary": { "type": "string" },
        "risk_score": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "original_spec_yaml": { "type": "string" },
        "proposed_patch_yaml": { "type": "string" },
        "created_at_unix": { "type": "integer" }
      },
      "required": ["incident_id", "namespace", "target_name", "diagnosis_summary", "proposed_patch_yaml"]
    },
    "incident.remediation.executed": {
      "description": "Execution status produced by k8s-executor post-remediation",
      "properties": {
        "incident_id": { "type": "string" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "ROLLED_BACK"] },
        "executed_by": { "type": "string" },
        "execution_message": { "type": "string" },
        "verified_healthy": { "type": "boolean" },
        "completed_at_unix": { "type": "integer" }
      },
      "required": ["incident_id", "status", "verified_healthy"]
    }
  }
}
